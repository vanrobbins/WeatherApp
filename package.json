{
  "name": "weather-app",
  "version": "1.0.0",
  "description": "Native JS weather app with Sass/BEM styling. No framework, no bundler.",
  "type": "module",
  "scripts": {
    "build": "sass src/scss/main.scss css/main.css --style=compressed --no-source-map",
    "dev": "sass --watch src/scss/main.scss css/main.css",
    "serve": "npx serve .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["weather", "vanilla-js", "sass", "bem"],
  "license": "MIT",
  "devDependencies": {
    "sass": "^1.77.0",
    "vitest": "^1.6.0"
  }
}
